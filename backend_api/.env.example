# ==============================================================================
# VELION AGENT — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Instrucciones para despliegue y transferencia:
# 1. Copiar este archivo a `.env` (`cp .env.example .env`).
# 2. Configurar las variables obligatorias marcadas como [REQUIRED].
# 3. Nunca incluir claves de producción reales en el control de versiones.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core / Server
# ------------------------------------------------------------------------------
# [REQUIRED] Puerto en el que escucha la API Express (default: 3000)
PORT=3000

# [OPTIONAL] Host IP de enlace (default: 0.0.0.0 para contenedor/VPS, 127.0.0.1 para local estricto)
HOST="0.0.0.0"

# [REQUIRED] Entorno de ejecución: 'production' | 'development' | 'test' (default: development)
NODE_ENV="development"

# [OPTIONAL] Habilitar workers y cron jobs en segundo plano en este proceso (default: true)
BACKGROUND_JOBS_ENABLED="true"

# [OPTIONAL] URL base pública canónica de la API backend (ej: https://api.tudominio.com)
APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 2. Database (PostgreSQL)
# ------------------------------------------------------------------------------
# [REQUIRED] Cadena de conexión a PostgreSQL 15+ con pooling o directo
DATABASE_URL="postgresql://user:password@localhost:5432/velion_db?schema=public"

# ------------------------------------------------------------------------------
# 3. Auth / Encryption / Security
# ------------------------------------------------------------------------------
# [REQUIRED] Secreto criptográfico maestro para firma de JSON Web Tokens (min 32 caracteres)
JWT_SECRET="generate_a_secure_random_32_character_secret_here"

# [REQUIRED] Llave de cifrado AES-256-GCM para tokens de integración (Shopify/Meta) (min 32 caracteres o 64 hex)
TOKEN_ENCRYPTION_KEY="generate_a_secure_random_32_character_encryption_key"

# [OPTIONAL] Llave de cifrado para snapshots pg_dump de base de datos (default: usa TOKEN_ENCRYPTION_KEY)
BACKUP_ENCRYPTION_KEY=""

# [REQUIRED] Secreto interno para validación de tokens entre microservicios/webhooks
BOT_SECRET="generate_a_secure_bot_secret_here"

# [REQUIRED] Secreto criptográfico para generación de tokens efímeros de streaming multimedia en CRM
MEDIA_TOKEN_SECRET="generate_a_secure_media_token_secret_here"

# [OPTIONAL] Credenciales para sembrado/bootstrap inicial del usuario SuperAdmin
INITIAL_SUPERADMIN_EMAIL="admin@velion.pe"
INITIAL_SUPERADMIN_PASSWORD="initial_secure_superadmin_password"

# ------------------------------------------------------------------------------
# 4. AI Providers (Google Gemini, Groq, OpenAI / Fallbacks)
# ------------------------------------------------------------------------------
# [OPTIONAL] Clave de API de Google Gemini (Proveedor Principal de IA conversacional)
GEMINI_API_KEY=""

# [OPTIONAL] Clave de respaldo de Google Gemini para tolerancia a fallos/rotación
GEMINI_API_KEY_BACKUP=""

# [OPTIONAL] Clave de API de Groq (Proveedor Secundario de alta velocidad / fallback)
GROQ_API_KEY=""

# [OPTIONAL] Modelo de Groq a utilizar (default: llama-3.3-70b-versatile)
GROQ_MODEL="llama-3.3-70b-versatile"

# [OPTIONAL] Clave alternativa para GitHub Models (fallback de inferencia)
GITHUB_MODELS_KEY=""
GITHUB_TOKEN=""

# [OPTIONAL] Prompt maestro de sistema compartido por todos los agentes (default: provisto por código)
SYSTEM_PROMPT="Eres un asistente de atención al cliente educado, eficiente y servicial."

# ------------------------------------------------------------------------------
# 5. WhatsApp Meta Cloud API (Official Embedded Signup & Coexistence)
# ------------------------------------------------------------------------------
# [OPTIONAL] Meta App ID (Meta Developer Dashboard)
META_APP_ID=""

# [OPTIONAL] Meta App Secret (Meta Developer Dashboard)
META_APP_SECRET=""

# [OPTIONAL] Config ID del flujo Embedded Signup v4 para WhatsApp Business App Coexistence
META_EMBEDDED_SIGNUP_CONFIG_ID=""

# [OPTIONAL] Token de verificación para el webhook de Meta Cloud API (default: velion_meta_verify_2024)
META_WEBHOOK_VERIFY_TOKEN="velion_meta_verify_2024"

# [OPTIONAL] Versión de la Graph API de Meta (default: v21.0)
META_GRAPH_API_VERSION="v21.0"

# [OPTIONAL] Credenciales estáticas fallback para pruebas manuales de Meta
META_PHONE_NUMBER_ID=""
META_ACCESS_TOKEN=""
VERIFY_TOKEN="velion_meta_verify_2024"

# ------------------------------------------------------------------------------
# 6. WhatsApp Gateways (Evolution API / WAHA)
# ------------------------------------------------------------------------------
# [OPTIONAL] URL de servicio del contenedor de Evolution API (default: http://localhost:8080)
EVOLUTION_API_URL="http://localhost:8080"

# [REQUIRED si usa Evolution] Clave de autenticación API de Evolution API
EVOLUTION_API_KEY="your_evolution_api_key_here"

# [OPTIONAL] Alternativa WAHA (WhatsApp HTTP API) si aplica
WAHA_API_URL="http://localhost:3001"
WAHA_API_KEY=""
WAHA_IS_PRIMARY="false"

# ------------------------------------------------------------------------------
# 7. Shopify Integration (E-Commerce Catalog Sync & Draft Orders)
# ------------------------------------------------------------------------------
# [OPTIONAL] Client ID de la App creada en Shopify Partners Dashboard
SHOPIFY_CLIENT_ID=""

# [OPTIONAL] Client Secret de la App creada en Shopify Partners Dashboard
SHOPIFY_CLIENT_SECRET=""

# [OPTIONAL] URI de redirección OAuth para Shopify (ej: https://api.tudominio.com/api/integrations/shopify/callback)
SHOPIFY_REDIRECT_URI="http://localhost:3000/api/integrations/shopify/callback"

# ------------------------------------------------------------------------------
# 8. Stripe (Suscripciones y Facturación)
# ------------------------------------------------------------------------------
# [OPTIONAL] Clave secreta de Stripe API (sk_test o sk_live)
STRIPE_SECRET_KEY=""

# [OPTIONAL] ID de precio recurrente del Plan Pro en Stripe (price_...)
STRIPE_PRICE_ID_PRO=""

# [OPTIONAL] Secreto de firma para webhooks entrantes de Stripe
STRIPE_WEBHOOK_SECRET=""

# ------------------------------------------------------------------------------
# 9. SMTP (Notificaciones por Correo Electrónico)
# ------------------------------------------------------------------------------
# [OPTIONAL] Servidor de correo saliente
SMTP_HOST="smtp.gmail.com"

# [OPTIONAL] Puerto SMTP (default: 587)
SMTP_PORT="587"

# [OPTIONAL] Usuario / Correo de envío
SMTP_USER=""

# [OPTIONAL] Contraseña de aplicación SMTP
SMTP_PASSWORD=""
SMTP_PASS=""

# ------------------------------------------------------------------------------
# 10. Almacenamiento Multimedia y Archivos
# ------------------------------------------------------------------------------
# [OPTIONAL] Rutas del sistema de archivos local para audios, imágenes y adjuntos
LOCAL_MEDIA_ROOT="./media/uploads"
PRIVATE_MEDIA_ROOT="./media/private"
MEDIA_ROOT_DIR="./media/uploads"
QUARANTINE_ROOT_DIR="./quarantine"

# [OPTIONAL] Retardo en milisegundos para reintentos de descarga de medios en gateways
GATEWAY_MEDIA_RETRY_DELAY_MS="2000"

# [OPTIONAL] Cloudinary (opcional para almacenamiento cloud de medios o backups)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ------------------------------------------------------------------------------
# 11. Facturación Manual Local (Perú - Yape / Plin / Transferencias)
# ------------------------------------------------------------------------------
# [OPTIONAL] Método de pago predeterminado mostrado al cliente (ej: Yape / Plin)
BILLING_PAYMENT_METHOD="Yape / Plin"

# [OPTIONAL] Titular / Destinatario del pago mostrado al cliente
BILLING_PAYMENT_RECIPIENT="Velion Corporation S.A.C."

# [OPTIONAL] Teléfono de contacto / WhatsApp para envío de comprobantes de pago
BILLING_PAYMENT_CONTACT="51999999999"

# ------------------------------------------------------------------------------
# 12. Respaldos Automatizados (Backups)
# ------------------------------------------------------------------------------
# [OPTIONAL] Frecuencia de respaldo automático: 'off' | 'daily' | 'weekly' (default: off)
BACKUP_FREQUENCY="off"

# [OPTIONAL] Habilitar subida a la nube de respaldos (default: false)
BACKUP_CLOUD_ENABLED="false"

# [OPTIONAL] Proveedor de respaldo en la nube: 'cloudinary' | 'gdrive' (default: cloudinary)
BACKUP_CLOUD_PROVIDER="cloudinary"

# ------------------------------------------------------------------------------
# 13. CORS / URLs de Frontend / Alertas
# ------------------------------------------------------------------------------
# [OPTIONAL] URL principal de la aplicación frontend (default: http://localhost:5173)
FRONTEND_URL="http://localhost:5173"

# [OPTIONAL] Lista de orígenes permitidos separados por comas (para despliegues multi-dominio)
# Ej: ALLOWED_ORIGINS="https://app.tudominio.com,https://admin.tudominio.com"
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000"

# [OPTIONAL] URL pública de webhook de Velion para recibir eventos externos
WEBHOOK_URL="http://localhost:3000/api/whatsapp/webhook"

# [OPTIONAL] Webhook de alertas del sistema (Discord / Slack / Teams) para notificar incidentes
ERROR_WEBHOOK=""

# ------------------------------------------------------------------------------
# 14. Modo Demostración y Desarrollo
# ------------------------------------------------------------------------------
# [OPTIONAL] Habilitar modo de prueba para campañas masivas (no envía mensajes reales)
CAMPAIGN_TEST_MODE="false"

# [OPTIONAL] Lista de UUIDs de tenants restringidos a entorno de demostración (separados por comas)
DEMO_TENANT_IDS=""

# [OPTIONAL] Números de WhatsApp autorizados para recibir respuestas en modo demostración
DEMO_ALLOWED_WHATSAPP_NUMBERS=""
