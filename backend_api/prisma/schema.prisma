generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                   String                     @id @default(uuid())
  name                 String
  plan                 String?                    @default("Sin Plan")
  planId               String?
  active               Boolean                    @default(true)
  msgLimit             Int                        @default(0)
  connLimit            Int                        @default(0)
  logoUrl              String?
  companyName          String?                    @default("")
  taxId                String?
  address              String?
  phone                String?
  email                String?
  businessSector       String?
  bankAccounts         String?
  businessHours        String?
  termsAndPolicies     String?
  customPrompt         String?
  botRole              String?
  multiMessageMode     Boolean                    @default(true)
  respondInGroups      Boolean                    @default(false)
  notificationPhone    String?
  notifySalesWhatsApp  Boolean                    @default(false)
  marketingModeEnabled Boolean                    @default(false)
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  aiEnabled            Boolean                    @default(true)
  aiDisabledAt         DateTime?
  sessionInactivityHours Int                      @default(6)
  dailyTokenBudget     Int?                       @default(100000)
  monthlyTokenBudget   Int?                       @default(2000000)
  aiBudgetEnabled      Boolean                    @default(true)
  alerts               Alert[]
  automationFlows      AutomationFlow[]
  campaigns            Campaign[]
  chats                Chat[]
  contacts             Contact[]
  customers            Customer[]
  flows                Flow[]
  messages             Message[]
  registeredNumbers    RegisteredWhatsAppNumber[]
  users                User[]
  orders               Order[]
  aiUsages             TenantAIUsage[]
  operationalItems     OperationalItem[]
}

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  password  String
  name      String?
  phone     String?
  role      String    @default("client")
  tenantId  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
  tenant    Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdOperationalItems   OperationalItem[] @relation("CreatedByUser")
  completedOperationalItems OperationalItem[] @relation("CompletedByUser")
}

model Contact {
  id              String   @id @default(uuid())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  botPaused       Boolean  @default(false)
  category        String   @default("Nuevos Leads")
  lastInteraction String?
  name            String
  phone           String
  tags            String[]
  tenantId        String
  chats           Chat[]
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  operationalItems OperationalItem[]
}

model Chat {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  botPaused Boolean   @default(false)
  contactId String
  status    String    @default("open")
  tenantId  String
  contact   Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  messages  Message[]
  operationalItems OperationalItem[]
}

model Message {
  id         String   @id @default(uuid())
  chatId     String
  content    String
  createdAt  DateTime @default(now())
  senderRole String
  tenantId   String
  externalId String?
  status     String   @default("sent")
  chat       Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  operationalItems OperationalItem[]
}

model AutomationFlow {
  id        String   @id @default(uuid())
  name      String
  isActive  Boolean  @default(false)
  nodes     Json
  edges     Json
  tenantId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Product {
  id               String    @id @default(uuid())
  name             String
  description      String?
  category         String?
  tags             String[]  @default([])
  type             String    @default("PHYSICAL_PRODUCT")
  price            Float
  isAvailable      Boolean   @default(true)
  imageUrl         String?
  promotionalPrice Float?
  promoStartDate   DateTime?
  promoEndDate     DateTime?
  userId           String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  images           String[]  @default([])
  videoUrl         String?
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderItems       OrderItem[]
}

model Alert {
  id        String   @id @default(uuid())
  type      String
  severity  String
  message   String
  resolved  Boolean  @default(false)
  tenantId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Plan {
  id                   String   @id @default(uuid())
  name                 String   @unique
  price                Float
  connLimit            Int      @default(1)
  msgLimit             Int      @default(1000)
  features             Json
  flowBuilder          Boolean  @default(false)
  aiBrain              Boolean  @default(false)
  popular              Boolean  @default(false)
  active               Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  hasAdvancedMarketing Boolean  @default(false)
  hasAutomations       Boolean  @default(false)
  hasCampaigns         Boolean  @default(false)
  maxProducts          Int      @default(10)
  dailyTokenBudget     Int?     @default(130000)
  monthlyTokenBudget   Int?     @default(2000000)
}

model SystemConfig {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model Customer {
  id                String    @id @default(uuid())
  phone             String
  name              String?
  preferences       String?
  isBanned          Boolean   @default(false)
  currentFlowId     String?
  currentNodeId     String?
  tags              String[]  @default([])
  isBotPaused       Boolean   @default(false)
  tenantId          String
  commercialState   Json?
  persistentProfile Json?
  sessionUpdatedAt  DateTime? @default(now())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orders            Order[]
  operationalItems  OperationalItem[]

  @@unique([tenantId, phone])
}

model Campaign {
  id               String        @id @default(uuid())
  name             String
  baseMessage      String
  media            String?
  status           String        @default("pending")
  delayMin         Int           @default(5)
  delayMax         Int           @default(15)
  tenantId         String
  scheduledAt      DateTime?
  recurrenceType   String        @default("NONE")
  nextRunAt        DateTime?
  lastRunAt        DateTime?
  anchorDay        Int?
  audienceType     String        @default("all")
  targetContactIds Json?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  tenant           Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  logs             CampaignLog[]

  @@index([status, nextRunAt])
  @@index([tenantId])
}

model CampaignLog {
  id            String    @id @default(uuid())
  campaignId    String
  customerPhone String
  status        String    @default("pending")
  sentMessage   String    @default("")
  errorMessage  String?
  occurrenceKey String?
  claimedAt     DateTime?
  sentAt        DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt
  campaign      Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([campaignId, status])
  @@unique([campaignId, customerPhone, occurrenceKey])
}

model Flow {
  id             String   @id @default(uuid())
  name           String
  triggerKeyword String
  nodes          Json
  edges          Json
  isActive       Boolean  @default(false)
  tenantId       String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model RegisteredWhatsAppNumber {
  id                String   @id @default(uuid())
  phoneNumber       String   @unique
  tenantId          String
  createdAt         DateTime @default(now())
  metaAccessToken   String?
  metaPhoneNumberId String?
  metaWabaId        String?
  provider          String    @default("EVOLUTION")
  updatedAt         DateTime  @updatedAt
  instanceName      String?   @unique
  connectionState   String    @default("UNKNOWN")
  connectionStateUpdatedAt DateTime? @default(now())
  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Order {
  id              String      @id @default(uuid())
  tenantId        String
  customerId      String
  
  status          String      @default("PENDING")
  paymentStatus   String      @default("UNPAID")
  
  paymentMethod   String?
  shippingCity    String?
  shippingAddress String?
  customerNeeds   String?
  totalAmount     Float       @default(0)
  
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  tenant          Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer        Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items           OrderItem[]
  operationalItems OperationalItem[]
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  productId String?
  name      String
  quantity  Int      @default(1)
  price     Float    @default(0)
  variant   String?
  
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
}

model TenantAIUsage {
  id           String   @id @default(uuid())
  tenantId     String
  date         String   // Formato YYYY-MM-DD
  requestCount Int      @default(0)
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  totalTokens  Int      @default(0)
  toolCalls    Int      @default(0)
  retryCount   Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, date])
}

model OperationalItem {
  id                String      @id @default(uuid())
  tenantId          String
  customerId        String?
  contactId         String?
  chatId            String?
  sourceMessageId   String?
  orderId           String?

  type              String      // 'NOTE' | 'TASK'
  category          String      @default("GENERAL") // 'GENERAL' | 'COORDINATION' | 'ATTENDANCE' | 'SERVICE_INSTRUCTION' | 'FOLLOW_UP' | 'ORDER_REQUEST' | 'SUPPORT' | 'OTHER'
  
  title             String?
  summary           String
  subjectName       String?
  
  status            String      @default("PENDING") // NOTE: 'ACTIVE' | 'ARCHIVED'. TASK: 'PENDING' | 'IN_PROGRESS' | 'COMPLETED' | 'CANCELED'
  priority          String      @default("NORMAL")  // 'LOW' | 'NORMAL' | 'HIGH'

  createdByType     String      @default("AI")      // 'AI' | 'USER'
  createdByUserId   String?
  completedAt       DateTime?
  completedByUserId String?

  dueDateLocal      String?     // 'YYYY-MM-DD'
  dueTimeLocal      String?     // 'HH:mm'
  dueAt             DateTime?   // UTC timestamp cuando fecha y hora son conocidas/calculables

  dedupeKey         String?

  details           Json?

  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  tenant            Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer          Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  contact           Contact?    @relation(fields: [contactId], references: [id], onDelete: SetNull)
  chat              Chat?       @relation(fields: [chatId], references: [id], onDelete: SetNull)
  sourceMessage     Message?    @relation(fields: [sourceMessageId], references: [id], onDelete: SetNull)
  order             Order?      @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdByUser     User?       @relation("CreatedByUser", fields: [createdByUserId], references: [id], onDelete: SetNull)
  completedByUser   User?       @relation("CompletedByUser", fields: [completedByUserId], references: [id], onDelete: SetNull)

  @@unique([tenantId, dedupeKey])
  @@index([tenantId, type, status])
  @@index([tenantId, chatId])
  @@index([tenantId, customerId])
  @@index([tenantId, dueDateLocal])
  @@index([tenantId, dueAt])
}

