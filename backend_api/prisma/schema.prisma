generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                   String                     @id @default(uuid())
  name                 String
  plan                 String?                    @default("Sin Plan")
  planId               String?
  active               Boolean                    @default(true)
  msgLimit             Int                        @default(0)
  connLimit            Int                        @default(0)
  logoUrl              String?
  companyName          String?                    @default("")
  taxId                String?
  address              String?
  phone                String?
  email                String?
  businessSector       String?
  bankAccounts         String?
  businessHours        String?
  termsAndPolicies     String?
  customPrompt         String?
  botRole              String?
  multiMessageMode     Boolean                    @default(true)
  respondInGroups      Boolean                    @default(false)
  notificationPhone    String?
  notifySalesWhatsApp  Boolean                    @default(false)
  marketingModeEnabled Boolean                    @default(false)
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  aiEnabled            Boolean                    @default(true)
  sessionInactivityHours Int                      @default(6)
  alerts               Alert[]
  automationFlows      AutomationFlow[]
  campaigns            Campaign[]
  chats                Chat[]
  contacts             Contact[]
  customers            Customer[]
  flows                Flow[]
  messages             Message[]
  registeredNumbers    RegisteredWhatsAppNumber[]
  users                User[]
}

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  password  String
  name      String?
  phone     String?
  role      String    @default("client")
  tenantId  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
  tenant    Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Contact {
  id              String   @id @default(uuid())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  botPaused       Boolean  @default(false)
  category        String   @default("Nuevos Leads")
  lastInteraction String?
  name            String
  phone           String
  tags            String[]
  tenantId        String
  chats           Chat[]
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Chat {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  botPaused Boolean   @default(false)
  contactId String
  status    String    @default("open")
  tenantId  String
  contact   Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  messages  Message[]
}

model Message {
  id         String   @id @default(uuid())
  chatId     String
  content    String
  createdAt  DateTime @default(now())
  senderRole String
  tenantId   String
  externalId String?
  status     String   @default("sent")
  chat       Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model AutomationFlow {
  id        String   @id @default(uuid())
  name      String
  isActive  Boolean  @default(false)
  nodes     Json
  edges     Json
  tenantId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Product {
  id               String    @id @default(uuid())
  name             String
  description      String?
  category         String?
  tags             String[]  @default([])
  price            Float
  isAvailable      Boolean   @default(true)
  imageUrl         String?
  promotionalPrice Float?
  promoStartDate   DateTime?
  promoEndDate     DateTime?
  userId           String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  images           String[]  @default([])
  videoUrl         String?
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Alert {
  id        String   @id @default(uuid())
  type      String
  severity  String
  message   String
  resolved  Boolean  @default(false)
  tenantId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Plan {
  id                   String   @id @default(uuid())
  name                 String   @unique
  price                Float
  connLimit            Int      @default(1)
  msgLimit             Int      @default(1000)
  features             Json
  flowBuilder          Boolean  @default(false)
  aiBrain              Boolean  @default(false)
  popular              Boolean  @default(false)
  active               Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  hasAdvancedMarketing Boolean  @default(false)
  hasAutomations       Boolean  @default(false)
  hasCampaigns         Boolean  @default(false)
  maxProducts          Int      @default(10)
}

model SystemConfig {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model Customer {
  id                String    @id @default(uuid())
  phone             String
  name              String?
  preferences       String?
  isBanned          Boolean   @default(false)
  currentFlowId     String?
  currentNodeId     String?
  tags              String[]  @default([])
  isBotPaused       Boolean   @default(false)
  tenantId          String
  commercialState   Json?
  persistentProfile Json?
  sessionUpdatedAt  DateTime? @default(now())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, phone])
}

model Campaign {
  id          String        @id @default(uuid())
  name        String
  baseMessage String
  media       String?
  status      String        @default("pending")
  delayMin    Int           @default(5)
  delayMax    Int           @default(15)
  tenantId    String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  logs        CampaignLog[]
}

model CampaignLog {
  id            String   @id @default(uuid())
  campaignId    String
  customerPhone String
  status        String
  sentMessage   String
  errorMessage  String?
  sentAt        DateTime @default(now())
  campaign      Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

model Flow {
  id             String   @id @default(uuid())
  name           String
  triggerKeyword String
  nodes          Json
  edges          Json
  isActive       Boolean  @default(false)
  tenantId       String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model RegisteredWhatsAppNumber {
  id                String   @id @default(uuid())
  phoneNumber       String   @unique
  tenantId          String
  createdAt         DateTime @default(now())
  metaAccessToken   String?
  metaPhoneNumberId String?
  metaWabaId        String?
  provider          String   @default("EVOLUTION")
  updatedAt         DateTime @updatedAt
  instanceName      String?
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}
