generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                      String                     @id @default(uuid())
  name                    String
  plan                    String?                    @default("Sin Plan")
  planId                  String?
  active                  Boolean                    @default(true)
  msgLimit                Int                        @default(0)
  connLimit               Int                        @default(0)
  logoUrl                 String?
  companyName             String?                    @default("")
  taxId                   String?
  address                 String?
  phone                   String?
  email                   String?
  businessSector          String?
  bankAccounts            String?
  businessHours           String?
  termsAndPolicies        String?
  customPrompt            String?
  botRole                 String?
  multiMessageMode        Boolean                    @default(true)
  respondInGroups         Boolean                    @default(false)
  notificationPhone       String?
  notifySalesWhatsApp     Boolean                    @default(false)
  marketingModeEnabled    Boolean                    @default(false)
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt
  aiEnabled               Boolean                    @default(true)
  aiDisabledAt            DateTime?
  sessionInactivityHours  Int                        @default(6)
  dailyTokenBudget        Int?                       @default(100000)
  monthlyTokenBudget      Int?                       @default(2000000)
  aiBudgetEnabled         Boolean                    @default(true)
  alerts                  Alert[]
  automationFlows         AutomationFlow[]
  campaigns               Campaign[]
  chats                   Chat[]
  contacts                Contact[]
  customers               Customer[]
  flows                   Flow[]
  messages                Message[]
  registeredNumbers       RegisteredWhatsAppNumber[]
  users                   User[]
  orders                  Order[]
  aiUsages                TenantAIUsage[]
  operationalItems        OperationalItem[]
  followUpEnabled         Boolean                    @default(false)
  followUpDecisionMode    String?                    @default("OFF")
  timezone                String?
  currencyCode            String                     @default("PEN")
  followUpSequences       FollowUpSequence[]
  integrations            Integration[]
  externalProducts        ExternalProduct[]
  externalProductVariants ExternalProductVariant[]
}

model User {
  id                        String            @id @default(uuid())
  email                     String            @unique
  password                  String
  name                      String?
  phone                     String?
  role                      String            @default("client")
  tenantId                  String?
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt
  products                  Product[]
  tenant                    Tenant?           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdOperationalItems   OperationalItem[] @relation("CreatedByUser")
  completedOperationalItems OperationalItem[] @relation("CompletedByUser")
}

model Contact {
  id               String            @id @default(uuid())
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  botPaused        Boolean           @default(false)
  category         String            @default("Nuevos Leads")
  lastInteraction  String?
  name             String
  phone            String
  tags             String[]
  tenantId         String
  chats            Chat[]
  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  operationalItems OperationalItem[]
}

model Chat {
  id                String             @id @default(uuid())
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  botPaused         Boolean            @default(false)
  contactId         String
  status            String             @default("open")
  tenantId          String
  contact           Contact            @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  messages          Message[]
  operationalItems  OperationalItem[]
  followUpSequences FollowUpSequence[]
}

model Message {
  id         String   @id @default(uuid())
  chatId     String
  content    String
  createdAt  DateTime @default(now())
  senderRole String
  tenantId   String
  externalId String?
  status     String   @default("sent")

  // Media Inbound / Outbound structured fields (CHAT-MEDIA-01)
  mediaType   String?
  mediaPath   String?
  mimeType    String?
  fileName    String?
  caption     String?
  mediaSize   Int?
  mediaStatus String?

  // Multi-Image Batch / Album support
  mediaGroupId    String?
  mediaGroupIndex Int?

  chat             Chat              @relation(fields: [chatId], references: [id], onDelete: Cascade)
  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  operationalItems OperationalItem[]

  @@index([chatId, mediaGroupId])
}

model AutomationFlow {
  id        String   @id @default(uuid())
  name      String
  isActive  Boolean  @default(false)
  nodes     Json
  edges     Json
  tenantId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Product {
  id               String      @id @default(uuid())
  name             String
  description      String?
  category         String?
  tags             String[]    @default([])
  type             String      @default("PHYSICAL_PRODUCT")
  price            Float
  isAvailable      Boolean     @default(true)
  imageUrl         String?
  promotionalPrice Float?
  promoStartDate   DateTime?
  promoEndDate     DateTime?
  sku              String?
  normalizedSku    String?
  userId           String
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  images           String[]    @default([])
  videoUrl         String?
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderItems       OrderItem[]

  @@index([userId, normalizedSku])
}

model Alert {
  id        String   @id @default(uuid())
  type      String
  severity  String
  message   String
  resolved  Boolean  @default(false)
  tenantId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Plan {
  id                   String   @id @default(uuid())
  name                 String   @unique
  price                Float
  connLimit            Int      @default(1)
  msgLimit             Int      @default(1000)
  features             Json
  flowBuilder          Boolean  @default(false)
  aiBrain              Boolean  @default(false)
  popular              Boolean  @default(false)
  active               Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  hasAdvancedMarketing Boolean  @default(false)
  hasAutomations       Boolean  @default(false)
  hasCampaigns         Boolean  @default(false)
  maxProducts          Int      @default(10)
  dailyTokenBudget     Int?     @default(130000)
  monthlyTokenBudget   Int?     @default(2000000)
}

model SystemConfig {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model Customer {
  id                        String             @id @default(uuid())
  phone                     String
  name                      String?
  preferences               String?
  isBanned                  Boolean            @default(false)
  currentFlowId             String?
  currentNodeId             String?
  tags                      String[]           @default([])
  isBotPaused               Boolean            @default(false)
  tenantId                  String
  commercialState           Json?
  persistentProfile         Json?
  sessionUpdatedAt          DateTime?          @default(now())
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt
  tenant                    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orders                    Order[]
  operationalItems          OperationalItem[]
  followUpSuppressed        Boolean            @default(false)
  followUpOptOutAt          DateTime?
  followUpSuppressionReason String?
  followUpSequences         FollowUpSequence[]

  @@unique([tenantId, phone])
}

model Campaign {
  id               String        @id @default(uuid())
  name             String
  baseMessage      String
  media            String?
  status           String        @default("pending")
  delayMin         Int           @default(5)
  delayMax         Int           @default(15)
  tenantId         String
  scheduledAt      DateTime?
  recurrenceType   String        @default("NONE")
  nextRunAt        DateTime?
  lastRunAt        DateTime?
  anchorDay        Int?
  audienceType     String        @default("all")
  targetContactIds Json?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  tenant           Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  logs             CampaignLog[]

  @@index([status, nextRunAt])
  @@index([tenantId])
}

model CampaignLog {
  id            String    @id @default(uuid())
  campaignId    String
  customerPhone String
  status        String    @default("pending")
  sentMessage   String    @default("")
  errorMessage  String?
  occurrenceKey String?
  claimedAt     DateTime?
  sentAt        DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt
  campaign      Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, customerPhone, occurrenceKey])
  @@index([campaignId])
  @@index([campaignId, status])
}

model Flow {
  id             String   @id @default(uuid())
  name           String
  triggerKeyword String
  nodes          Json
  edges          Json
  isActive       Boolean  @default(false)
  tenantId       String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model RegisteredWhatsAppNumber {
  id                       String    @id @default(uuid())
  phoneNumber              String    @unique
  tenantId                 String
  createdAt                DateTime  @default(now())
  metaAccessToken          String?
  metaPhoneNumberId        String?
  metaWabaId               String?
  provider                 String    @default("EVOLUTION")
  updatedAt                DateTime  @updatedAt
  instanceName             String?   @unique
  connectionState          String    @default("UNKNOWN")
  connectionStateUpdatedAt DateTime? @default(now())
  tenant                   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Order {
  id         String @id @default(uuid())
  tenantId   String
  customerId String

  status        String @default("PENDING")
  paymentStatus String @default("UNPAID")

  paymentMethod   String?
  shippingCity    String?
  shippingAddress String?
  customerNeeds   String?
  totalAmount     Float   @default(0)

  // Integraciones de Comercio Externo (Shopify, etc.)
  externalProvider     String?
  externalDraftOrderId String?
  externalOrderId      String?
  externalOrderNumber  String?
  externalCheckoutUrl  String?
  currencyCode         String?

  externalSyncStatus   String?
  externalSyncAttempts Int       @default(0)
  externalSyncError    String?
  externalSyncedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer          Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items             OrderItem[]
  operationalItems  OperationalItem[]
  followUpSequences FollowUpSequence[]

  @@index([tenantId, externalSyncStatus])
  @@index([tenantId, externalDraftOrderId])
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  productId String?
  name      String
  quantity  Int     @default(1)
  price     Float   @default(0)
  variant   String?

  // Snapshot histórico de procedencia comercial externa
  sourceProvider    String?
  externalProductId String?
  externalVariantId String?
  sourceSku         String?

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
}

model TenantAIUsage {
  id           String   @id @default(uuid())
  tenantId     String
  date         String // Formato YYYY-MM-DD
  requestCount Int      @default(0)
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  totalTokens  Int      @default(0)
  toolCalls    Int      @default(0)
  retryCount   Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, date])
}

model OperationalItem {
  id              String  @id @default(uuid())
  tenantId        String
  customerId      String?
  contactId       String?
  chatId          String?
  sourceMessageId String?
  orderId         String?

  type     String // 'NOTE' | 'TASK'
  category String @default("GENERAL") // 'GENERAL' | 'COORDINATION' | 'ATTENDANCE' | 'SERVICE_INSTRUCTION' | 'FOLLOW_UP' | 'ORDER_REQUEST' | 'SUPPORT' | 'OTHER'

  title       String?
  summary     String
  subjectName String?

  status   String @default("PENDING") // NOTE: 'ACTIVE' | 'ARCHIVED'. TASK: 'PENDING' | 'IN_PROGRESS' | 'COMPLETED' | 'CANCELED'
  priority String @default("NORMAL") // 'LOW' | 'NORMAL' | 'HIGH'

  createdByType     String    @default("AI") // 'AI' | 'USER'
  createdByUserId   String?
  completedAt       DateTime?
  completedByUserId String?

  dueDateLocal String? // 'YYYY-MM-DD'
  dueTimeLocal String? // 'HH:mm'
  dueAt        DateTime? // UTC timestamp cuando fecha y hora son conocidas/calculables

  dedupeKey String?

  details Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer        Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  contact         Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  chat            Chat?     @relation(fields: [chatId], references: [id], onDelete: SetNull)
  sourceMessage   Message?  @relation(fields: [sourceMessageId], references: [id], onDelete: SetNull)
  order           Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdByUser   User?     @relation("CreatedByUser", fields: [createdByUserId], references: [id], onDelete: SetNull)
  completedByUser User?     @relation("CompletedByUser", fields: [completedByUserId], references: [id], onDelete: SetNull)

  @@unique([tenantId, dedupeKey])
  @@index([tenantId, type, status])
  @@index([tenantId, chatId])
  @@index([tenantId, customerId])
  @@index([tenantId, dueDateLocal])
  @@index([tenantId, dueAt])
}

model FollowUpSequence {
  id         String  @id @default(uuid())
  tenantId   String
  customerId String
  chatId     String?
  orderId    String?

  productId       String?
  productName     String?
  stageAtCreation String

  status String @default("SCHEDULED")
  // 'SCHEDULED' | 'PROCESSING' | 'NEUTRALIZED_INBOUND' | 'WAITING_NEXT' | 'RECOVERED' | 'EXHAUSTED' | 'CANCELLED'

  currentAttempt Int @default(0)
  maxAttempts    Int @default(3)

  anchorAt  DateTime
  nextRunAt DateTime?
  lastRunAt DateTime?
  claimedAt DateTime?

  cancelReason     String?
  recoveredAt      DateTime?
  recoveredOrderId String?

  contextSnapshot   Json?
  explicitTimingIso DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  chat     Chat?             @relation(fields: [chatId], references: [id], onDelete: SetNull)
  order    Order?            @relation(fields: [orderId], references: [id], onDelete: SetNull)
  attempts FollowUpAttempt[]

  @@index([status, nextRunAt])
  @@index([tenantId, customerId])
  @@index([tenantId, status])
  @@index([tenantId, nextRunAt])
}

model FollowUpAttempt {
  id            String @id @default(uuid())
  sequenceId    String
  attemptNumber Int

  status String @default("PENDING")
  // Operational status (never changes after SENT):
  // 'PENDING' | 'PROCESSING' | 'SENT' | 'FAILED_SAFE' | 'UNKNOWN_DELIVERY' | 'SKIPPED_POLICY'

  // Delivery lifecycle (separate from operational status):
  // null | 'SERVER_ACK' | 'DELIVERY_ACK' | 'READ' | 'PLAYED' | 'ERROR'
  deliveryStatus String?
  deliveredAt    DateTime?
  readAt         DateTime?

  scheduledAt       DateTime
  sentAt            DateTime?
  claimedAt         DateTime?
  dispatchStartedAt DateTime?

  sentMessage       String?
  provider          String
  providerMessageId String?
  errorMessage      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sequence FollowUpSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)

  @@unique([sequenceId, attemptNumber])
  @@index([sequenceId])
  @@index([status])
  @@index([providerMessageId])
}

model Integration {
  id       String @id @default(uuid())
  tenantId String
  provider String // 'SHOPIFY' | 'WOOCOMMERCE' | 'TIENDANUBE' | 'MERCADOLIBRE'
  status   String @default("DISCONNECTED") // 'CONNECTED' | 'DISCONNECTED' | 'ERROR'

  shopDomain String?

  encryptedAccessToken  String? // Cifrado AES-256-GCM
  encryptedRefreshToken String? // Cifrado AES-256-GCM (Tokens expirables 2026)

  accessTokenExpiresAt  DateTime? // Marca temporal de expiración
  refreshTokenExpiresAt DateTime? // Marca temporal de expiración

  scopes String[] @default([])

  catalogMode       String @default("COMBINED") // 'VELION_ONLY' | 'SHOPIFY_ONLY' | 'COMBINED'
  priceSource       String @default("SHOPIFY") // 'VELION' | 'SHOPIFY'
  stockSource       String @default("SHOPIFY") // 'VELION' | 'SHOPIFY'
  externalOrderMode String @default("SHOPIFY_DRAFT") // 'NONE' | 'SHOPIFY_DRAFT' | 'SHOPIFY_COMPLETE'
  shopCurrencyCode  String?

  syncProducts  Boolean @default(true)
  syncInventory Boolean @default(true)

  lastSyncedAt  DateTime?
  syncStatus    String?   @default("IDLE") // 'IDLE' | 'SYNCING' | 'ERROR'
  lastSyncError String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  externalProducts ExternalProduct[]

  @@unique([tenantId, provider])
  @@unique([provider, shopDomain])
  @@index([tenantId, status])
}

model ExternalProduct {
  id                   String    @id @default(uuid())
  tenantId             String
  integrationId        String
  provider             String    @default("SHOPIFY")
  externalId           String // GID: 'gid://shopify/Product/123456789'
  title                String
  description          String?
  category             String?
  tags                 String[]  @default([])
  imageUrl             String?
  images               String[]  @default([])
  isAvailable          Boolean   @default(true)
  syncedAt             DateTime  @default(now())
  lastEventTriggeredAt DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  tenant      Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  integration Integration              @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  variants    ExternalProductVariant[]

  @@unique([tenantId, provider, externalId])
  @@index([tenantId, provider])
  @@index([integrationId])
}

model ExternalProductVariant {
  id                String @id @default(uuid())
  tenantId          String
  externalProductId String
  provider          String @default("SHOPIFY")

  externalVariantId String // GID: 'gid://shopify/ProductVariant/987654321'
  inventoryItemId   String? // GID: 'gid://shopify/InventoryItem/55555'

  sku           String?
  normalizedSku String?

  title String

  price          Float
  compareAtPrice Float?

  inventoryQuantity Int     @default(0)
  availableForSale  Boolean @default(true)

  syncedAt             DateTime  @default(now())
  lastEventTriggeredAt DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  externalProduct ExternalProduct @relation(fields: [externalProductId], references: [id], onDelete: Cascade)

  @@unique([tenantId, provider, externalVariantId])
  @@index([tenantId, provider])
  @@index([tenantId, provider, normalizedSku])
  @@index([externalProductId])
}

model ProcessedWebhook {
  id          String   @id // X-Shopify-Webhook-Id
  topic       String
  shopDomain  String
  tenantId    String?
  processedAt DateTime @default(now())

  @@index([shopDomain])
  @@index([processedAt])
}
